@page
@model ModuloMonolitico.Web.Pages.InfraAdmin.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Administração do Sistema";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/InfraAdmin/css/index.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div class="page-badge page-badge--restrito">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Acesso Restrito
    </div>
    <h1 class="titulo-pagina">Administração Master</h1>
    <p class="subtitulo-pagina">Controle global e auditoria do sistema SaaS.</p>
</div>

<div class="modulos-grid">
    @await Component.InvokeAsync("ModuloCard", new { 
        url = ModuloRotas.InfraAdmin.HistoricoLogin, 
        nome = "Histórico de Logins", 
        descricao = "Auditoria de acessos, tentativas com falha e controle de IP.", 
        textoLink = "Acessar Auditoria", 
        corHexadecimal = "#ff4d4f", corRgb = "255, 77, 79", 
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff4d4f\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new { 
        url = ModuloRotas.InfraAdmin.UltimosConectados, 
        nome = "Últimos Conectados", 
        descricao = "Monitoramento em tempo real dos usuários recentemente online.", 
