@page
@model ModuloMonolitico.Web.Pages.InfraAdmin.Sessao.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Inspetor de Sessão";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/InfraAdmin/css/sessao-index.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div>
        <div class="page-badge page-badge--restrito">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
            Diagnóstico
        </div>
        <h1 class="titulo-pagina">Inspetor de Sessão e Token JWT</h1>
        <p class="subtitulo-pagina">Análise de claims e cookie JWT da conexão atual (Master).</p>
    </div>
</div>

<div class="sessao-token-card">
    <h2>Token Armazenado</h2>
    <div class="sessao-token-box">@Model.TokenArmazenado</div>
</div>

<div class="log-table-wrapper">
    <div class="tabela-responsiva">
        <table class="log-table" data-seletor-colunas="true">
            <thead>
                <tr>
                    <th>Tipo (Claim)</th>
                    <th>Valor</th>
                    <th>Emissor</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.InformacoesClaims.Any())
                {
                    <tr>
                        <td colspan="3">
                            <div class="log-vazio">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                <div>Nenhuma claim encontrada na sessão atual.</div>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var claim in Model.InformacoesClaims)
                {
                    <tr>
                        <td><span class="log-data-secundaria">@claim.Tipo</span></td>
                        <td><span class="log-data-principal">@claim.Valor</span></td>
                        <td><span class="badge-provedor">@claim.Emissor</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Contextos/Shared/js/seletor-colunas.js" asp-append-version="true"></script>
}
