@page
@model ModuloMonolitico.Web.Pages.InfraAdmin.GruposSaaS.EditarModel
@{
    ViewData[ViewDataKeys.Title] = $"Editar Grupo SaaS — {Model.Nome}";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/InfraAdmin/css/grupossaas-editar.css" asp-append-version="true" />
}

<partial name="Toolbars/_ToolbarForm" model='new ModuloMonolitico.Web.Pages.Shared.Toolbars.ToolbarViewModel() {
    UrlVoltar = ModuloRotas.InfraAdmin.GruposSaaS,
    TextoVoltar = "Grupos SaaS",
    Titulo = "Editar Grupo SaaS",
    Subtitulo = "Atualize as permissões de acesso à plataforma para este grupo."
}' />

<main class="main-content formulario-container">
    <div class="group-meta">
        <span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Criado em: @Model.GrupoAtual?.DataInclusao.ToString("dd/MM/yyyy HH:mm")
        </span>
        <span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            Última atualização: @Model.GrupoAtual?.DataUltimaAtualizacao.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>

    <form method="post">
        <app-input type="hidden" asp-for="Id" />

        <div class="cartao-formulario">
            <p class="titulo-secao-formulario">Dados do Grupo</p>
            <div class="grade-formulario">
                <app-input asp-for="Nome"
                           label="Nome do Grupo"
                           type="text"
                           placeholder="ex: Moderador de Conteúdo"
                           required="required"
                           maxlength="100" />

                <div class="campo-grupo-descricao">
                    <app-textarea asp-for="Descricao"
                                  label="Descrição"
                                  rows="2"
                                  placeholder="Descreva brevemente o propósito deste grupo..." />
                </div>

                <app-toggle asp-for="Ativo" title="Grupo ativo" label-on="Sim" label-off="Não" />
            </div>
        </div>

        <div class="cartao-formulario">
            <p class="titulo-secao-formulario">Permissões de Acesso à Plataforma SaaS</p>

            @foreach (var modulo in Model.RecursosPorModulo)
            {
                <div class="modulo-block">
                    <div class="modulo-label">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        @modulo.Key
                        <span class="modulo-label-badge">@modulo.Count() recurso(s)</span>
                        <app-button type="button" variant="ghost" size="sm" class="btn-marcar-todos" data-modulo="@modulo.Key">marcar todos</app-button>
                    </div>
                    <div class="recursos-grid" data-modulo-grid="@modulo.Key">
                        @foreach (var recurso in modulo)
                        {
                            var isChecked = Model.RecursosVinculados.Contains(recurso.Id);
                            <label class="recurso-check @(isChecked ? "checked" : "")" for="rec_@recurso.Id">
                                <app-checkbox id="rec_@recurso.Id"
                                       name="RecursosSelecionados"
                                       value="@recurso.Id"
                                       data-modulo="@modulo.Key"
                                       checked="@isChecked"
                                       class="mb-0" />
                                <div class="recurso-info">
                                    <span class="recurso-nome">@recurso.Nome</span>
                                    @if (!string.IsNullOrEmpty(recurso.Descricao))
                                    {
                                        <span class="recurso-desc">@recurso.Descricao</span>
                                    }
                                    <span class="recurso-tipo @(recurso.Tipo == "tela" ? "tipo-tela" : "tipo-acao")">@recurso.Tipo</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="acoes-formulario">
            <a href="@($"{ModuloRotas.InfraAdmin.GruposSaaS_Usuarios}?id={Model.Id}")" class="link-membros">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                Gerenciar membros deste grupo
            </a>
            <a href="@ModuloRotas.InfraAdmin.GruposSaaS" class="btn-cancelar">Cancelar</a>
            <app-save-button type="submit">Salvar Alterações</app-save-button>
        </div>
    </form>
</main>

@section Scripts {
    <script src="~/Contextos/InfraAdmin/js/grupossaas-editar.js" asp-append-version="true"></script>
}
