@page
@model ModuloMonolitico.Web.Pages.InfraAdmin.Grupos.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Grupos de Usuários";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/InfraAdmin/css/grupos-index.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            Segurança
        </div>
        <h1 class="titulo-pagina">Grupos de Usuários</h1>
        <p class="subtitulo-pagina">Crie grupos e defina quais telas e ações cada um pode acessar no tenant.</p>
    </div>
    <div class="cabecalho-pagina-acoes">
        <a href="@ModuloRotas.InfraAdmin.Grupos_Novo" class="botao botao-primario btn-cabecalho-novo">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Novo Grupo
        </a>
    </div>
</div>

<div class="log-table-wrapper">
    <div class="tabela-responsiva">
        <table class="log-table" data-seletor-colunas="true" id="TbGrupos">
            <thead>
                <tr>
                    <th>Nome do Grupo</th>
                    <th>Descrição</th>
                    <th>Nível</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DadosPaginados == null || !Model.DadosPaginados.Itens.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="log-vazio">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                                <div>Nenhum grupo cadastrado.</div>
                                <a href="@ModuloRotas.InfraAdmin.Grupos_Novo" class="botao botao-primario botao-estado-vazio">Cadastrar agora</a>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var grupo in Model.DadosPaginados?.Itens ?? [])
                {
                    <tr>
                        <td><span class="grupo-nome-celula">@grupo.Nome</span></td>
                        <td><span class="grupo-descricao-celula">@(string.IsNullOrEmpty(grupo.Descricao) ? "—" : grupo.Descricao)</span></td>
                        <td>
                            @if (grupo.EhAdministrador || grupo.Id == Guid.Empty)
                            {
                                <span class="admin-badge">Master</span>
                            }
                            else
                            {
                                <span class="grupo-nivel-padrao">Padrão</span>
                            }
                        </td>
                        <td>
                            <span class="situacao-badge @(grupo.Ativo ? "situacao-ativo" : "situacao-inativo")">
                                @(grupo.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>
                            <a href="@($"{ModuloRotas.InfraAdmin.Grupos_Editar}?id={grupo.Id}")" class="btn-editar">Configurar Permissões</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/Contextos/Shared/js/seletor-colunas.js" asp-append-version="true"></script>
    <script src="~/Contextos/InfraAdmin/js/grupos-index.js" asp-append-version="true"></script>
}
