@page
@model ModuloMonolitico.Web.Pages.Perfil.MeusVinculos.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Meus Vínculos";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Perfil/css/meus-vinculos-index.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div>
        <div class="selo-pagina">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Perfil
        </div>
        <h1 class="titulo-pagina">Meus Vínculos & Convites</h1>
        <p class="subtitulo-pagina">Gerencie as empresas que você faz parte e os convites pendentes.</p>
    </div>
</div>

<div class="vinculos-grid">
    <div class="glass-card">
        <div class="glass-card-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <h2 class="glass-card-title">Convites Pendentes</h2>
        </div>
        <div class="glass-card-body">
            @if (!Model.ConvitesPendentes.Any())
            {
                <div class="vinculos-empty">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line>
                    </svg>
                    <p>Nenhum convite pendente.</p>
                </div>
            }
            else
            {
                <div class="vinculos-list">
                    @foreach (var convite in Model.ConvitesPendentes)
                    {
                        <div class="vinculo-item">
                            <div class="vinculo-item-header">
                                <h3 class="vinculo-item-nome">@convite.EmpresaNome</h3>
                                <span class="vinculo-pill">@convite.Perfil</span>
                            </div>
                            <p class="vinculo-item-meta">Enviado em @convite.DataInclusao.ToShortDateString()</p>
                            <div class="vinculo-item-actions">
                                <form method="post" asp-page-handler="Responder">
                                    <app-input type="hidden" name="empresaId" value="@convite.EmpresaId" />
                                    <app-input type="hidden" name="aceitar" value="true" />
                                    <app-button type="submit" variant="primary" class="botao-vinculo">Aceitar</app-button>
                                </form>
                                <form method="post" asp-page-handler="Responder">
                                    <app-input type="hidden" name="empresaId" value="@convite.EmpresaId" />
                                    <app-input type="hidden" name="aceitar" value="false" />
                                    <app-button type="submit"
                                                variant="danger"
                                                class="botao-vinculo"
                                                data-confirmacao="Recusar este convite? Será necessário um novo convite para ingressar na equipe."
                                                data-confirmacao-tipo="perigo">
                                        Recusar
                                    </app-button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="glass-card">
        <div class="glass-card-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            <h2 class="glass-card-title">Minhas Empresas</h2>
        </div>
        <div class="glass-card-body">
            @if (!Model.EmpresasAceitas.Any())
            {
                <div class="vinculos-empty">
                    <p>Você ainda não faz parte de nenhuma empresa.</p>
                </div>
            }
            else
            {
                <div class="vinculos-list">
                    @foreach (var emp in Model.EmpresasAceitas)
                    {
                        <div class="vinculo-item vinculo-item--ativo">
                            <div class="vinculo-item-info">
                                <h3 class="vinculo-item-nome">@emp.EmpresaNome</h3>
                                <p class="vinculo-item-meta">Perfil: @emp.Perfil</p>
                            </div>
                            <div class="vinculo-item-status">
                                <span class="vinculo-pill vinculo-pill--ativo">Ativo</span>
                                <span class="vinculo-item-data">Desde @emp.DataInclusao.ToShortDateString()</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
