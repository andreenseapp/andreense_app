<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="@ViewData[ViewDataKeys.Description]" />
  <title>@ViewData[ViewDataKeys.Title] — Andreense</title>
  <link rel="icon" type="image/png" href="/img/brand/favicon.png" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/Contextos/Shared/css/sistema-design.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/Contextos/Shared/css/layout-aplicacao.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/Contextos/Shared/css/rodape.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/Contextos/Shared/css/painel-desempenho.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/ModuloMonolitico.Web.styles.css" asp-append-version="true" />

  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="fundo-animado" aria-hidden="true"></div>

<partial name="~/Pages/Shared/Partials/_LoadingProcessoCritico.cshtml" />

@if (User.Identity?.IsAuthenticated == true && User.FindFirst("email_validado")?.Value != "true")
{
    <div class="alerta-email-banner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>Seu e-mail ainda não foi validado. Algumas funcionalidades podem estar limitadas.</span>
        <a href="@ModuloRotas.Autenticacao.ValidarEmail" class="email-alert-link">Validar Agora</a>
    </div>
}

<div class="layout-app">
  <partial name="Toolbars/_ToolbarHub" model="new ModuloMonolitico.Web.Pages.Shared.Toolbars.ToolbarViewModel()" />

  <div class="conteudo-pagina">
    @RenderBody()
  </div>

  @{
      if (ViewData[ViewDataKeys.SemRodapePadrao] is true || IsSectionDefined("SemRodape"))
      {
          if (IsSectionDefined("SemRodape")) { IgnoreSection("SemRodape"); }
      }
      else
      {
          <partial name="~/Pages/Shared/Partials/_Rodape.cshtml" />
      }
  }
</div>

<script src="~/Contextos/Shared/js/utils/mascaras.js" asp-append-version="true"></script>
<script src="~/Contextos/Shared/js/utils/formatadores.js" asp-append-version="true"></script>
<script src="~/Contextos/Shared/js/utils/validadores.js" asp-append-version="true"></script>
<script src="~/Contextos/Shared/js/utils/ferramentas.js" asp-append-version="true"></script>
<script src="~/Contextos/Shared/js/app.js" asp-append-version="true"></script>
<script src="~/Contextos/Shared/js/painel-desempenho.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

@await Component.InvokeAsync("PainelDesempenho")

<partial name="~/Pages/Shared/Partials/_ModalAuditoria.cshtml" />

<div class="mensagens-servidor"
     data-sucesso="@TempData[TempDataKeys.MensagemSucesso]"
     data-erro="@TempData[TempDataKeys.MensagemErro]">
</div>

</body>
</html>
