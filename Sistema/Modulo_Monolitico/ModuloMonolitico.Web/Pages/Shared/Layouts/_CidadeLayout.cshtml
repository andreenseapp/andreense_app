@using ModuloMonolitico.Web.Core
@{
    Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
    var caminhoAtual = Context.Request.Path.Value ?? "";
    var contextoPasta = ViewData[ViewDataKeys.ContextoPasta]?.ToString()
        ?? MapeadorContextoAssets.ResolverPastaContexto(caminhoAtual)
        ?? "Cidadania";

    bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "#") return false;
        return caminhoAtual.Equals(path, StringComparison.OrdinalIgnoreCase) ||
               caminhoAtual.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    bool semMenuLateral = ViewData["SemMenuLateral"] is true ||
                          caminhoAtual.Equals("/Contextos/Cidadania", StringComparison.OrdinalIgnoreCase) ||
                          caminhoAtual.Equals("/Contextos/Cidadania/", StringComparison.OrdinalIgnoreCase) ||
                          caminhoAtual.Equals("/Cidadania/Index", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Shared/css/layout-cidade.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Contextos/@contextoPasta/css/comum.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

<div class="modulo-container @(semMenuLateral ? "modulo-container--sem-menu" : "")">
    @if (!semMenuLateral)
    {
        <aside class="modulo-barra-lateral">
            <div class="modulo-barra-titulo">Módulo Cidade</div>
            
            <a href="@ModuloRotas.Cidadania.Index" class="modulo-nav-item @(IsActive("/Cidadania/Index") ? "active" : "")">
                <span class="modulo-nav-icone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                </span>
                Serviços da Cidade
            </a>

            <div class="modulo-barra-titulo">Serviços Disponíveis</div>

            <a href="@ModuloRotas.Cidadania.AchadosPerdidos" class="modulo-nav-item @(IsActive("/Cidadania/AchadosPerdidos") ? "active" : "")">
                <span class="modulo-nav-icone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </span>
                Achados e Perdidos
            </a>

            <a href="@ModuloRotas.Cidadania.CodigoBarras" class="modulo-nav-item @(IsActive("/Cidadania/CodigoBarras") ? "active" : "")">
                <span class="modulo-nav-icone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="6" y1="9" x2="6" y2="15"></line><line x1="10" y1="9" x2="10" y2="15"></line><line x1="14" y1="9" x2="14" y2="15"></line><line x1="18" y1="9" x2="18" y2="15"></line></svg>
                </span>
                Código de Barras
            </a>

            <a href="@ModuloRotas.Cidadania.EtiquetaEnvio" class="modulo-nav-item @(IsActive("/Cidadania/EtiquetaEnvio") ? "active" : "")">
                <span class="modulo-nav-icone">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </span>
                Etiquetas de Envio
            </a>
        </aside>
    }

    <main class="modulo-conteudo">
        @RenderBody()
    </main>
</div>

@section Scripts {
    <script src="~/Contextos/@contextoPasta/js/comum.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
