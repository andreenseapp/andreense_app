@using ModuloMonolitico.Web.Core
@{
    Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
    var caminhoAtual = Context.Request.Path.Value ?? "";
    var contextoPasta = "Imobiliaria";

    bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path) || path == "#") return false;
        return caminhoAtual.Equals(path, StringComparison.OrdinalIgnoreCase) ||
               caminhoAtual.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Shared/css/layout-cidade.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Contextos/@contextoPasta/css/comum.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

<div class="modulo-container">
    <aside class="modulo-barra-lateral">
        <a href="@ModuloRotas.Imobiliaria.MeusAnuncios" class="modulo-nav-item @(IsActive(ModuloRotas.Imobiliaria.MeusAnuncios) && !IsActive(ModuloRotas.Imobiliaria.MeusAnuncios_Perfil) ? "active" : "")">
            <span class="modulo-nav-icone">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            </span>
            Meus Imóveis
        </a>

        <a href="@ModuloRotas.Imobiliaria.MeusAnuncios_Perfil" class="modulo-nav-item @(IsActive(ModuloRotas.Imobiliaria.MeusAnuncios_Perfil) ? "active" : "")">
            <span class="modulo-nav-icone">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </span>
            Perfil do anunciante
        </a>

        <a href="@ModuloRotas.Imoveis.Index" class="modulo-nav-item modulo-nav-item--subtle">
            <span class="modulo-nav-icone">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </span>
            Ver portal
        </a>
    </aside>

    <main class="modulo-conteudo">
        @RenderBody()
    </main>
</div>

@section Scripts {
    <script src="~/Contextos/@contextoPasta/js/comum.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
