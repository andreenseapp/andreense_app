@{
    var ano = DateTime.Now.Year;
}
<footer class="rodape-app">
    <div class="app-footer-inner">
        <div class="app-footer-brand">
            <img src="/img/brand/logo-sm.png" alt="Andreense" class="app-footer-logo" />
            <span class="app-footer-name">Andreense</span>
        </div>

        <p class="app-footer-copy">
            &copy; @ano Andreense. Todos os direitos reservados.
        </p>

        <div class="app-footer-links">
            <a href="mailto:suporte@andreense.com.br" class="app-footer-link">Suporte</a>
            <span class="app-footer-sep">·</span>
            <a href="@ModuloRotas.Perfil.MeuPerfil" class="app-footer-link">Minha Conta</a>
        </div>
    </div>
</footer>



