@model ModuloMonolitico.Web.Pages.Shared.Components.ModuloCard.ModuloCardViewModel

@if (Model.EmBreve)
{
    <div class="modulo-card em-breve">
        <div class="modulo-icon bg-breve">
            @Html.Raw(Model.SvgIcone)
        </div>
        <div>
            <div class="modulo-nome">@Model.Nome <span class="modulo-badge">EM BREVE</span></div>
            <div class="modulo-desc">@Model.Descricao</div>
        </div>
        <div class="modulo-link link-breve">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Desenvolvimento
        </div>
    </div>
}
else
{
    <a href="@Model.Url" class="modulo-card" style="--card-cor-rgb: @Model.CorRgb; --card-cor-hex: @Model.CorHexadecimal;">
        <div class="modulo-icon colorido">
            @Html.Raw(Model.SvgIcone.Replace("currentColor", Model.CorHexadecimal).Replace("stroke=\"\"", "stroke=\"" + Model.CorHexadecimal + "\""))
        </div>
        <div>
            <div class="modulo-nome">@Model.Nome</div>
            <div class="modulo-desc">@Model.Descricao</div>
        </div>
        <div class="modulo-link colorido">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            @Model.TextoLink
        </div>
    </a>
}
