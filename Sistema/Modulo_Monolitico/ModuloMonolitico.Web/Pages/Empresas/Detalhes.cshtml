@page

@model ModuloMonolitico.Web.Pages.Empresas.DetalhesModel

@{

    var empresa = Model.Empresa!;

    var titulo = string.IsNullOrEmpty(empresa.Nome) ? empresa.RazaoSocial : empresa.Nome;

    ViewData[ViewDataKeys.Title] = titulo ?? "Detalhes da Empresa";

    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";

    var urlEditar = $"{ModuloRotas.Empresas.Empresas_Editar}?id={empresa.Id}";

    var subtitulo = !string.IsNullOrEmpty(empresa.RazaoSocial) && empresa.RazaoSocial != empresa.Nome

        ? empresa.RazaoSocial

        : "Visualização dos dados cadastrais e fiscais da filial.";

}



@section Styles {

    <link rel="stylesheet" href="~/Contextos/Empresas/css/empresas-detalhes.css" asp-append-version="true" />

}



<div class="cabecalho-pagina">

    <div>

        <div class="selo-pagina">

            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 21h18M3 7v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M9 3h6v4H9z"></path><line x1="9" y1="11" x2="15" y2="11"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>

            Base

        </div>

        <h1 class="titulo-pagina">@titulo</h1>

        <p class="subtitulo-pagina">@subtitulo</p>

    </div>

    <div class="cabecalho-pagina-acoes">

        <a href="@ModuloRotas.Empresas.Index" class="botao botao-fantasma botao-voltar">← Empresas</a>

        <a href="@urlEditar" class="botao botao-primario btn-header-editar">

            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"></path></svg>

            Editar Cadastro

        </a>

    </div>

</div>



<main class="main-content empresas-detalhes-container">

    <div class="detalhes-grid">

        <div class="detalhes-col-principal">

            <section class="info-card">

                <h2 class="info-card-title">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 21h18M3 7v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M9 3h6v4H9z"></path></svg>

                    Informações Fiscais e Cadastrais

                </h2>

                <div class="info-grid">

                    <div class="info-field">

                        <span class="info-label">Nome Fantasia</span>

                        <span class="info-value">@empresa.Nome</span>

                    </div>

                    <div class="info-field">

                        <span class="info-label">Razão Social</span>

                        <span class="info-value">@(string.IsNullOrEmpty(empresa.RazaoSocial) ? "—" : empresa.RazaoSocial)</span>

                    </div>

                    <div class="info-field">

                        <span class="info-label">CNPJ</span>

                        <span class="info-value info-value-mono">@(string.IsNullOrEmpty(empresa.Cnpj) ? "—" : empresa.Cnpj)</span>

                    </div>

                    <div class="info-field">

                        <span class="info-label">Inscrição Estadual</span>

                        <span class="info-value">@(string.IsNullOrEmpty(empresa.InscricaoEstadual) ? "—" : empresa.InscricaoEstadual)</span>

                    </div>

                    <div class="info-field">

                        <span class="info-label">Segmento / Atividade</span>

                        <span class="info-value info-value-capitalize">@(string.IsNullOrEmpty(empresa.Segmento) ? "—" : empresa.Segmento)</span>

                    </div>

                    <div class="info-field">

                        <span class="info-label">CNAE Principal</span>

                        <span class="info-value info-value-mono">@(string.IsNullOrEmpty(empresa.CnaePrincipal) ? "—" : empresa.CnaePrincipal)</span>

                    </div>

                </div>

            </section>



            <section class="info-card">

                <h2 class="info-card-title">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>

                    Endereço da Sede

                </h2>



                @if (string.IsNullOrEmpty(empresa.Logradouro))

                {

                    <p class="endereco-vazio">Nenhum endereço cadastrado para esta empresa.</p>

                }

                else

                {

                    <div class="endereco-box">

                        <div class="info-grid">

                            <div class="info-field">

                                <span class="info-label">Logradouro e Número</span>

                                <span class="info-value">@empresa.Logradouro, @empresa.Numero</span>

                            </div>

                            <div class="info-field">

                                <span class="info-label">Bairro</span>

                                <span class="info-value">@(string.IsNullOrEmpty(empresa.Bairro) ? "—" : empresa.Bairro)</span>

                            </div>

                            <div class="info-field">

                                <span class="info-label">Cidade / UF</span>

                                <span class="info-value">@empresa.Cidade / @empresa.Uf</span>

                            </div>

                            <div class="info-field">

                                <span class="info-label">CEP</span>

                                <span class="info-value info-value-mono">@(string.IsNullOrEmpty(empresa.Cep) ? "—" : empresa.Cep)</span>

                            </div>

                        </div>

                    </div>

                }

            </section>

        </div>



        <aside class="detalhes-col-lateral">

            <section class="info-card">

                <h2 class="info-card-title">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.18V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>

                    Status e Auditoria

                </h2>

                <div class="meta-list">

                    <div class="meta-item">

                        <span class="info-label">Status de Atividade</span>

                        <span class="distintivo-situacao @(empresa.Ativo ? "situacao-ativo" : "situacao-inativo")">

                            @(empresa.Ativo ? "Ativa" : "Inativa")

                        </span>

                    </div>

                    <div class="meta-item">

                        <span class="info-label">Data de Inclusão</span>

                        <span class="info-value">@empresa.DataInclusao.ToString("dd/MM/yyyy HH:mm")</span>

                    </div>

                    <div class="meta-item">

                        <span class="info-label">Última Atualização</span>

                        <span class="info-value">@empresa.DataUltimaAtualizacao.ToString("dd/MM/yyyy HH:mm")</span>

                    </div>

                </div>

            </section>

        </aside>

    </div>

</main>

