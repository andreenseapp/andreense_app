@page

@model ModuloMonolitico.Web.Pages.Autenticacao.LoginModel

@{

  ViewData[ViewDataKeys.Title] = "Entrar — Andreense";

  Layout = null;

  var googleIdCliente = ViewData[ViewDataKeys.GoogleClientId]?.ToString() ?? string.Empty;

  var googleHabilitado = !string.IsNullOrEmpty(googleIdCliente);

}

<!DOCTYPE html>

<html lang="pt-BR">

<head>

  <meta charset="utf-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content="Acesse o sistema Andreense com suas credenciais." />

  <title>@ViewData[ViewDataKeys.Title]</title>

  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <partial name="~/Pages/Shared/Partials/_ContextoStandaloneHead.cshtml" />
  <link rel="stylesheet" href="@Model.UrlCssPagina" asp-append-version="true" />

</head>

<body data-rota-login-google="@ModuloRotas.Autenticacao.LoginGoogle" data-rota-esqueci-senha="@ModuloRotas.Autenticacao.EsqueciSenha">

<div class="fundo-animado" aria-hidden="true"></div>



<main class="layout-autenticacao autenticacao-principal" role="main">

  <partial name="~/Pages/Shared/Partials/_ContextoStandaloneThemeToggle.cshtml" />



  <div class="cartao-autenticacao">

    <div class="marca-autenticacao">

      <div class="autenticacao-marca-icone autenticacao-marca-logo" aria-hidden="true">

        <img src="/img/brand/logo-lg.png" alt="Andreense Logo" />

      </div>

      <h1>Bem-vindo</h1>

      <p>Acesse sua conta para continuar</p>

    </div>



    <form method="post" id="form-login" novalidate data-sem-validacao-blur="true">

      @Html.AntiForgeryToken()

      <app-input type="hidden" name="ReturnUrl" value="@Model.UrlRetorno" />



      <app-input asp-for="Formulario.Email"

            type="email"

            placeholder="seu@email.com"

            maxlength="255"

            autocomplete="email"

            autofocus="autofocus" />



      <app-input asp-for="Formulario.Senha"

            type="password"

            placeholder="Sua senha"

            maxlength="128"

            autocomplete="current-password" />


      <div class="autenticacao-manter-conectado">
        <app-checkbox asp-for="Formulario.ManterConectado" label="Manter conectado" class="mb-0" />
        <a href="@ModuloRotas.Autenticacao.EsqueciSenha" id="link-esqueci-senha">Esqueci minha senha</a>
      </div>



      <app-button type="submit" variant="primary" id="btn-login" full-width="true">Entrar</app-button>

    </form>



    <div class="divider">ou</div>



    @if (googleHabilitado)

    {

      <div id="btn-google-login-container"

           class="btn-google-container"

           data-google-id-cliente="@googleIdCliente"></div>

    }

    else

    {

      <button type="button" class="botao-google botao-google--desabilitado" disabled title="Login com Google nao configurado." aria-disabled="true">

        <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">

          <path fill="#4285F4" d="M46.145 24.503c0-1.636-.133-3.2-.38-4.697H24v8.882h12.444c-.537 2.909-2.17 5.373-4.622 7.027v5.844h7.487c4.38-4.033 6.836-9.978 6.836-17.056z"/>

          <path fill="#34A853" d="M24 48c6.24 0 11.47-2.07 15.293-5.604l-7.487-5.844c-2.073 1.39-4.722 2.21-7.806 2.21-6.003 0-11.085-4.054-12.9-9.504H3.396v6.037C7.2 42.633 15.012 48 24 48z"/>

          <path fill="#FBBC05" d="M11.1 29.258A14.895 14.895 0 0 1 10.345 24c0-1.823.315-3.593.755-5.258v-6.037H3.396A23.97 23.97 0 0 0 0 24c0 3.87.927 7.532 2.562 10.758L11.1 29.258z"/>

          <path fill="#EA4335" d="M24 9.556c3.38 0 6.418 1.163 8.807 3.445l6.6-6.6C35.464 2.37 30.234 0 24 0 15.012 0 7.2 5.367 3.396 13.242l7.704 5.5C12.915 13.61 17.997 9.556 24 9.556z"/>

        </svg>

        <span>Entrar com Google</span>

        <span class="selo-em-breve">Em breve</span>

      </button>

    }



    <div class="link-autenticacao">

      Não tem conta? <a href="@ModuloRotas.Autenticacao.Cadastro">Criar conta gratuita</a>

    </div>

  </div>

</main>



@if (googleHabilitado)

{

  <script src="https://accounts.google.com/gsi/client" async></script>

}



<div class="mensagens-servidor"
     data-sucesso="@TempData[TempDataKeys.MensagemSucesso]"
     data-erro="@(TempData[TempDataKeys.MensagemErro] ?? Model.MensagemErro)">
</div>

<partial name="~/Pages/Shared/Partials/_ContextoStandaloneFoot.cshtml" />
<script src="@Model.UrlJsPagina" asp-append-version="true"></script>
</body>

</html>




