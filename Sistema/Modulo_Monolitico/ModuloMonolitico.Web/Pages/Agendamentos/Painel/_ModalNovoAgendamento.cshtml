<div class="modal-backdrop" id="modalNovoAgendamento">
    <div class="modal-dialog">
        <div class="modal-header" style="flex-direction: column; align-items: flex-start; gap: 8px; flex-shrink: 0;">
            <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <img src="/img/brand/logo-sm.png" alt="Andreense" style="height: 24px; border-radius: 4px;" />
                    <span style="font-weight: 700; font-size: 16px; color: var(--clr-primary, #1a73e8);">Andreense</span>
                </div>
                <button type="button" class="btn-close-modal" data-fechar-modal>&times;</button>
            </div>
            <h2 class="modal-title" style="margin-top: 4px;">Cadastre o cliente e escolha um horário livre na agenda.</h2>
        </div>
        <form id="formModalAgendamento" method="post" asp-page-handler="SalvarModal" style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; margin: 0;">
            <div class="modal-body" style="flex: 1; min-height: 0; overflow-y: auto; padding: 20px 24px;">
                <div class="modal-grid">
                    
                    <div class="campo-grupo full-width">
                        <label>Nome do cliente *</label>
                        <input type="text" name="ClienteNome" class="input-moderno" placeholder="Nome completo do cliente" required />
                    </div>

                    <div class="campo-grupo full-width">
                        <label>Contato</label>
                        <input type="text" name="ClienteTelefone" class="input-moderno" placeholder="(11) 99999-9999" />
                    </div>

                    <div class="campo-grupo full-width">
                        <label>Serviço *</label>
                        <select name="ProdutoVariacaoId" id="modalServicoAgendamento" class="input-moderno" required>
                            <option value="">Selecione o serviço desejado...</option>
                            @if (Model.Servicos != null)
                            {
                                @foreach (var servico in Model.Servicos)
                                {
                                    <option value="@servico.Id">
                                        @servico.Descricao — @servico.DuracaoMinutos min (@servico.PrecoVenda.ToString("C"))
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="campo-grupo half-width">
                        <label>Data *</label>
                        <input type="date" name="DataAgendamento" id="modalDataAgendamento" class="input-moderno" required />
                    </div>

                    <div class="campo-grupo half-width">
                        <label>Horário *</label>
                        <select name="Horario" id="modalHorarioAgendamento" class="input-moderno" required>
                            <option value="">Selecione o horário</option>
                        </select>
                    </div>

                    <div class="campo-grupo full-width">
                        <label>Observações</label>
                        <textarea name="Observacoes" class="input-moderno" rows="3" placeholder="Observações adicionais (opcional)..."></textarea>
                    </div>

                </div>
            </div>

            <div class="modal-footer" style="flex-shrink: 0; padding: 16px 24px; border-top: 1px solid var(--glass-border); display: flex; justify-content: flex-end; gap: 12px; background: inherit;">
                <button type="button" class="btn-cancelar" data-fechar-modal>Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Agendamento</button>
            </div>
        </form>
    </div>
</div>
