@page
@model ModuloMonolitico.Web.Pages.Cidadania.EtiquetaEnvio.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Gerador de Etiquetas de Envio Correios";
    Layout = "~/Pages/Shared/Layouts/_CidadeLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Cidadania/css/etiqueta-envio.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <partial name="Partials/_LinkVoltar" model='new LinkVoltarModelo { Url = ModuloRotas.Cidadania.Index, TextoDestino = "Serviços da Cidade" }' />
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            Cidade
        </div>
        <h1 class="titulo-pagina">Gerador de Etiquetas de Envio</h1>
        <p class="subtitulo-pagina">Crie etiquetas de envio no padrão oficial dos Correios prontas para impressão gratuitamente.</p>
    </div>
</div>

<div class="label-container">
    <div class="card-form">
        <div class="section-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"></path></svg>
            Dados da Etiqueta
        </div>

        <div class="form-tabs" role="tablist">
            <app-button type="button" variant="ghost" class="form-tab-btn active" data-aba="destinatario" role="tab" aria-selected="true">Destinatário (Recebe)</app-button>
            <app-button type="button" variant="ghost" class="form-tab-btn" data-aba="remetente" role="tab" aria-selected="false">Remetente (Envia)</app-button>
        </div>

        <div id="tab-destinatario" class="form-section-fields active" role="tabpanel">
            <div class="form-grid">
                <app-input type="text" id="dest-nome" label="Nome Completo" placeholder="Ex: CAROL JACOPI" autocomplete="off" />
                <app-input type="text" id="dest-cep" label="CEP" placeholder="Ex: 01311-200" maxlength="9" autocomplete="off" />
                <app-input type="text" id="dest-endereco" label="Endereço Completo (Rua, Av, Bairro)" placeholder="Ex: Avenida Paulista, 1500" autocomplete="off" />
                <app-input type="text" id="dest-cidade" label="Cidade / UF" placeholder="Ex: São Paulo - SP" autocomplete="off" />
            </div>
        </div>

        <div id="tab-remetente" class="form-section-fields" role="tabpanel">
            <div class="form-grid">
                <app-input type="text" id="rem-nome" label="Nome Completo" placeholder="Ex: IGOR JACOPI" autocomplete="off" />
                <app-input type="text" id="rem-cep" label="CEP" placeholder="Ex: 09015-000" maxlength="9" autocomplete="off" />
                <app-input type="text" id="rem-endereco" label="Endereço Completo (Rua, Av, Bairro)" placeholder="Ex: Rua Coronel Oliveira Lima, 120" autocomplete="off" />
                <app-input type="text" id="rem-cidade" label="Cidade / UF" placeholder="Ex: Santo André - SP" autocomplete="off" />
            </div>
        </div>

        <app-button type="button" variant="primary" class="botao-imprimir" data-action="imprimir">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Imprimir Etiqueta (PDF / Impressora)
        </app-button>
    </div>

    <div class="card-preview-wrapper">
        <div class="section-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            Visualização da Impressão
        </div>

        <div class="preview-pane">
            <div class="correios-label-box" id="label-to-print">
                <div class="label-header">
                    <img id="correios-img-logo" src="~/img/logo-correios.png" asp-append-version="true" alt="Correios" class="correios-img-logo" />

                    <div id="correios-svg-logo" class="correios-svg-logo" hidden>
                        <svg class="correios-logo" width="160" height="95" viewBox="0 0 160 95" xmlns="http://www.w3.org/2000/svg" aria-label="Correios">
                            <defs>
                                <linearGradient id="correiosBlueGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#009fe3" />
                                    <stop offset="100%" stop-color="#00315a" />
                                </linearGradient>
                                <linearGradient id="correiosYellowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#ffcc00" />
                                    <stop offset="100%" stop-color="#ec8700" />
                                </linearGradient>
                            </defs>
                            <g transform="translate(48, 2) scale(0.95)">
                                <path d="M43.2,19.2 C45.5,16.9 45.9,13.9 45.9,10.9 L45.9,1.2 C45.9,0.4 45.5,0 44.7,0 L35.1,0 C33,0 31,0.8 29.5,2.3 L2.3,29.5 C0.8,31 0,33 0,35.1 C0,37.2 0.8,39.2 2.3,40.7 L11.9,50.3 C14.9,53.3 20.1,53.3 23.1,50.3 L39.2,34.2 C41.5,31.9 41.9,28.9 41.9,25.9 L41.9,16.9 Z" fill="url(#correiosBlueGrad)" />
                                <path d="M22.7,35.1 L6.6,19 C4.3,16.7 3.9,13.7 3.9,10.7 L3.9,1.2 L13.5,1.2 C15.6,1.2 17.6,2 19.1,3.5 L46.3,30.7 C47.8,32.2 48.6,34.2 48.6,36.3 C48.6,38.4 47.8,40.4 46.3,41.9 L36.7,51.5 C33.7,54.5 28.5,54.5 25.5,51.5 L10.8,36.8 Z" fill="url(#correiosYellowGrad)" opacity="0.95" />
                            </g>
                            <text x="80" y="82" font-family="'Segoe UI', Arial, sans-serif" font-weight="bold" font-size="28" fill="#00315a" text-anchor="middle" letter-spacing="-0.5">Correios</text>
                        </svg>
                    </div>
                </div>

                <div class="block-destinatario">
                    <div class="destinatario-title">DESTINATÁRIO</div>
                    <div class="title-separator"></div>
                    <div class="destinatario-info">
                        <strong id="preview-dest-nome">ANDREIA CARDOSO</strong>
                        <div id="preview-dest-endereco">Avenida Paulista, 1500</div>
                        <div id="preview-dest-cidade">São Paulo - SP</div>
                        <div id="preview-dest-cep-text" class="preview-cep-bold">CEP 01311-200</div>
                    </div>

                    <div class="cep-barcode-wrapper">
                        <div class="simulated-barcode-cep" aria-hidden="true"></div>
                    </div>
                </div>

                <div class="block-remetente">
                    <div class="remetente-title">REMETENTE</div>
                    <div class="title-separator"></div>
                    <div class="remetente-info">
                        <strong id="preview-rem-nome">IGOR SILVA</strong>
                        <div id="preview-rem-endereco">Rua Coronel Oliveira Lima, 120</div>
                        <div id="preview-rem-cidade">Santo André - SP</div>
                        <div id="preview-rem-cep" class="preview-cep-bold">CEP 09015-000</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Contextos/Cidadania/js/etiqueta-envio.js" asp-append-version="true"></script>
}
