@page
@model ModuloMonolitico.Web.Pages.Cidadania.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Cidade";
    ViewData["SemMenuLateral"] = true;
    Layout = "~/Pages/Shared/Layouts/_CidadeLayout.cshtml";
}

<div class="cabecalho-pagina cabecalho-pagina--centro">
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Cidade
        </div>
        <h1 class="titulo-pagina">Serviços da Cidade</h1>
        <p class="subtitulo-pagina">Acesse informações e utilidades públicas.</p>
    </div>
</div>

<div class="modulos-grid">
    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Imobiliaria.Index,
        nome = "Imóveis",
        descricao = "Compre, venda ou alugue imóveis em Santo André direto de proprietários ou imobiliárias locais.",
        textoLink = "Acessar Imóveis",
        corHexadecimal = "#0e5c9a", corRgb = "14, 92, 154",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#0e5c9a\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Cidadania.AchadosPerdidos,
        nome = "Achados e Perdidos",
        descricao = "Consulte objetos encontrados ou relate perdas na cidade.",
        textoLink = "Acessar",
        corHexadecimal = "#06b6d4", corRgb = "6, 182, 212",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#06b6d4\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Cidadania.CodigoBarras,
        nome = "Gerador de Códigos de Barras",
        descricao = "Crie imagens de códigos de barras em diversos formatos industriais gratuitamente.",
        textoLink = "Acessar Gerador",
        corHexadecimal = "#06b6d4", corRgb = "6, 182, 212",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#06b6d4\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"6\" y1=\"9\" x2=\"6\" y2=\"15\"></line><line x1=\"10\" y1=\"9\" x2=\"10\" y2=\"15\"></line><line x1=\"14\" y1=\"9\" x2=\"14\" y2=\"15\"></line><line x1=\"18\" y1=\"9\" x2=\"18\" y2=\"15\"></line></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Cidadania.EtiquetaEnvio,
        nome = "Gerador de Etiquetas de Envio",
        descricao = "Crie etiquetas de envio no padrão oficial dos Correios prontas para impressão.",
        textoLink = "Acessar Gerador",
        corHexadecimal = "#06b6d4", corRgb = "6, 182, 212",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#06b6d4\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"></path><polyline points=\"22,6 12,13 2,6\"></polyline></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Curriculos.Index,
        nome = "Banco de Talentos & Currículos",
        descricao = "Encontre profissionais locais ou cadastre seu currículo para novas oportunidades.",
        textoLink = "Acessar Banco de Talentos",
        corHexadecimal = "#6366f1", corRgb = "99, 102, 241",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z\"></path><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>"
    })
</div>
