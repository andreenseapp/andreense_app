@using ModuloMonolitico.Dominio.Entidades
@model AchadoPerdido

<div class="item-card">
    @if (!string.IsNullOrEmpty(Model.UrlImagem))
    {
        <img src="@Model.UrlImagem" class="item-image" alt="@Model.Titulo" />
    }
    else
    {
        <div class="item-image-placeholder" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
        </div>
    }

    <div class="item-content">
        <span class="item-badge badge-@Model.Tipo">@Model.Tipo</span>
        <h3 class="item-title">@Model.Titulo</h3>
        <p class="item-desc">@Model.Descricao</p>

        <div class="item-meta">
            <div class="item-meta-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                @Model.LocalVisto
            </div>

            @if (!Model.EsconderContato)
            {
                <div class="item-meta-row item-contact">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    @Model.ContatoInfo
                </div>
            }
            else
            {
                <div class="item-contact-protected">Informações de contato protegidas</div>
            }
        </div>
    </div>

    <div class="item-footer">
        <span>@Model.DataEvento?.ToShortDateString()</span>
        <span>@Model.Situacao</span>
    </div>
</div>
