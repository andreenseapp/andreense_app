@page
@model ModuloMonolitico.Web.Pages.Veiculos.DetalhesModel
@{
    ViewData["Title"] = Model.Anuncio is not null ? $"{Model.Anuncio.Titulo} — Veículos" : "Veículo";
    Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Veiculos/css/comum.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Contextos/Veiculos/css/detalhes.css" asp-append-version="true" />
}

@if (Model.Anuncio is null)
{
    <div class="veic-detalhe-erro">
        <h1>Anúncio não encontrado</h1>
        <a href="@ModuloRotas.Veiculos.Index">Voltar aos veículos</a>
    </div>
}
else
{
    var a = Model.Anuncio;
    <div class="veic-detalhe" data-id="@a.AnuncioVeiculoId">
        <div class="veic-detalhe-header">
            <a href="@ModuloRotas.Veiculos.Index" class="veic-detalhe-voltar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                Voltar aos veículos
            </a>
            @if (!string.IsNullOrEmpty(a.CodigoPublico))
            {
                <span class="veic-detalhe-codigo">@a.CodigoPublico</span>
            }
        </div>

        <div class="veic-detalhe-layout">
            <div class="veic-detalhe-galeria">
                @if (a.Fotos.Count > 0)
                {
                    <div class="veic-galeria" id="galeria-veic">
                        <div class="galeria-principal">
                            <img src="@a.Fotos[0]" alt="@a.Titulo" class="galeria-foto-principal" id="foto-principal" />
                        </div>
                        @if (a.Fotos.Count > 1)
                        {
                            <div class="galeria-miniaturas">
                                @foreach (var foto in a.Fotos)
                                {
                                    <img src="@foto" alt="Foto do veículo" class="galeria-miniatura" loading="lazy" />
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="veic-detalhe-sem-foto">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3m-4 13H19a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 002 2z"/></svg>
                        <span>Sem fotos</span>
                    </div>
                }
            </div>

            <div class="veic-detalhe-info">
                <div class="veic-detalhe-topo">
                    @if (a.EhDestaque)
                    {
                        <span class="veic-badge veic-badge--destaque">⭐ Destaque</span>
                    }
                    @if (a.AceitaTroca)
                    {
                        <span class="veic-badge veic-badge--troca">🔄 Aceita troca</span>
                    }
                </div>

                <h1 class="veic-detalhe-titulo">@a.Titulo</h1>

                <div class="veic-detalhe-marca-modelo">
                    <strong>@a.Marca @a.Modelo</strong>
                    @if (!string.IsNullOrEmpty(a.Versao))
                    {
                        <span>@a.Versao</span>
                    }
                </div>

                <div class="veic-detalhe-preco">
                    <span class="veic-preco-valor">@($"R$ {a.Preco:N0}")</span>
                </div>

                <div class="veic-detalhe-specs">
                    <div class="spec-item">
                        <span class="spec-label">Ano Fab./Mod.</span>
                        <span class="spec-valor">@a.AnoFabricacao / @a.AnoModelo</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Quilometragem</span>
                        <span class="spec-valor">@($"{a.Quilometragem:N0}") km</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Combustível</span>
                        <span class="spec-valor">@a.Combustivel</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Câmbio</span>
                        <span class="spec-valor">@a.Cambio</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-label">Cor</span>
                        <span class="spec-valor">@a.Cor</span>
                    </div>
                    @if (a.NumeroPortas.HasValue)
                    {
                        <div class="spec-item">
                            <span class="spec-label">Portas</span>
                            <span class="spec-valor">@a.NumeroPortas</span>
                        </div>
                    }
                    <div class="spec-item">
                        <span class="spec-label">Tipo</span>
                        <span class="spec-valor">@a.TipoVeiculo</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(a.Descricao))
                {
                    <div class="veic-detalhe-descricao">
                        <h2 class="descricao-titulo">Descrição</h2>
                        <p class="descricao-texto">@a.Descricao</p>
                    </div>
                }

                <div class="veic-detalhe-vendedor">
                    <div class="vendedor-header">
                        @if (!string.IsNullOrEmpty(a.LogoVendedor))
                        {
                            <img src="@a.LogoVendedor" alt="@a.NomeVendedor" class="vendedor-logo" />
                        }
                        <div class="vendedor-info">
                            <span class="vendedor-nome">@a.NomeVendedor</span>
                            @if (!string.IsNullOrEmpty(a.InstagramVendedor))
                            {
                                <a href="https://instagram.com/@(a.InstagramVendedor.TrimStart('@'))" target="_blank" rel="noopener" class="vendedor-instagram">@a.InstagramVendedor</a>
                            }
                        </div>
                    </div>

                    <div class="veic-cta-contato">
                        @if (!string.IsNullOrEmpty(a.ContatoWhatsapp))
                        {
                            var numero = new string(a.ContatoWhatsapp.Where(char.IsDigit).ToArray());
                            var mensagem = Uri.EscapeDataString($"Olá! Vi o anúncio \"{a.Titulo}\" ({a.CodigoPublico}) e gostaria de mais informações.");
                            <a href="https://wa.me/55@(numero)?text=@mensagem" target="_blank" rel="noopener" class="btn-whatsapp">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                Entrar em contato
                            </a>
                        }

                        @if (Model.EhProprietario || Model.UsuarioEhMaster)
                        {
                            <a href="@ModuloRotas.VeiculosSaaS.MeusAnuncios_Editar?id=@a.AnuncioVeiculoId" class="btn-editar-anuncio">
                                Editar anúncio
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Contextos/Veiculos/js/detalhes.js" asp-append-version="true"></script>
}
