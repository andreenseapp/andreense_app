@page
@model ModuloMonolitico.Web.Pages.Notificacoes.IndexModel
@{
  ViewData[ViewDataKeys.Title] = "Notificações";
  ViewData[ViewDataKeys.Description] = "Central de alertas e notificações do sistema.";
  Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
}

@section Styles {
  <link rel="stylesheet" href="~/Contextos/Notificacoes/css/index.css" asp-append-version="true" />
}

<div class="notif-wrapper">

  <div class="notif-cabecalho-pagina">
    <div>
      <h1>
        <svg class="notif-header-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        Notificações
      </h1>
      @if (Model.TotalNaoLidas > 0)
      {
        <p>@Model.TotalNaoLidas notificação(ões) não lida(s)</p>
      }
      else
      {
        <p>Tudo em dia!</p>
      }
    </div>
    @if (Model.TotalNaoLidas > 0)
    {
      <form method="post" asp-page-handler="MarcarTodasLidas">
        <app-button type="submit" variant="ghost" id="btn-marcar-todas">Marcar todas como lidas</app-button>
      </form>
    }
  </div>

  <nav class="notif-tabs" aria-label="Filtros de notificações">
    <a href="@ModuloRotas.Notificacoes.Index" class="notif-tab @(Model.FiltroAtivo == "todas" ? "active" : "")">Todas (@Model.Notificacoes.Count)</a>
    <a href="@(ModuloRotas.Notificacoes.Index + "?filtro=nao_lidas")" class="notif-tab @(Model.FiltroAtivo == "nao_lidas" ? "active" : "")">Não lidas (@Model.TotalNaoLidas)</a>
    <a href="@(ModuloRotas.Notificacoes.Index + "?filtro=info")" class="notif-tab @(Model.FiltroAtivo == "info" ? "active" : "")">Info</a>
    <a href="@(ModuloRotas.Notificacoes.Index + "?filtro=alerta")" class="notif-tab @(Model.FiltroAtivo == "alerta" ? "active" : "")">Alerta</a>
    <a href="@(ModuloRotas.Notificacoes.Index + "?filtro=sucesso")" class="notif-tab @(Model.FiltroAtivo == "sucesso" ? "active" : "")">Sucesso</a>
    <a href="@(ModuloRotas.Notificacoes.Index + "?filtro=erro")" class="notif-tab @(Model.FiltroAtivo == "erro" ? "active" : "")">Erro</a>
  </nav>

  @if (!Model.Notificacoes.Any())
  {
    <div class="notif-empty">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
      <h3>Nenhuma notificação</h3>
      <p>
        @(Model.FiltroAtivo == "todas"
          ? "Você não tem nenhuma notificação ainda."
          : $"Nenhuma notificação do tipo \"{Model.FiltroAtivo}\" encontrada.")
      </p>
    </div>
  }
  else
  {
    <div class="notif-list" role="list" aria-label="Lista de notificações">
      @foreach (var n in Model.Notificacoes)
      {
        var tipoClass = $"tipo-{n.Tipo}";
        var lida = n.Lida ? "" : "nao-lida";

        <article class="notif-card @tipoClass @lida" role="listitem" id="notif-@n.Id">

          <div class="notif-icon @tipoClass" aria-hidden="true">
            @switch (n.Tipo)
            {
              case "info":
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                break;
              case "alerta":
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                break;
              case "sucesso":
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                break;
              case "erro":
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                break;
            }
          </div>

          <div class="notif-body">
            <p class="notif-titulo">
              @n.Titulo
              @if (n.EhGlobal)
              {
                <span class="notif-badge-global" title="Notificação enviada a todos os usuários da conta">Global</span>
              }
            </p>
            <p class="notif-mensagem">@n.Mensagem</p>
            <div class="notif-footer">
              <span class="notif-data">@n.DataInclusao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
              @if (!string.IsNullOrWhiteSpace(n.LinkAcao))
              {
                <a href="@n.LinkAcao" class="notif-link">Ver detalhes</a>
              }
            </div>
          </div>

          @if (!n.Lida)
          {
            <div class="notif-actions">
              <form method="post" asp-page-handler="MarcarLida">
                <app-input type="hidden" asp-for="NotificacaoId" value="@n.Id" />
                <app-button type="submit" variant="ghost" size="sm" class="btn-marcar-lida" title="Marcar como lida" aria-label="Marcar notificação como lida">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </app-button>
              </form>
            </div>
          }

        </article>
      }
    </div>
  }

</div>
