@model ModuloMonolitico.Web.Pages.Fiscal.Parametros.ViewModels.FormularioConfiguracaoEmissao

@if (Model.Ambiente == 1)
{
    <div class="alerta-producao">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>Ambiente de <strong>Produção</strong> ativo. As notas emitidas terão validade legal perante a Receita Federal.</span>
    </div>
}

<div class="rotulo-secao-formulario">
    <span>Identificação e Talonário</span>
    <div class="campo-check-ativo">
        <app-checkbox asp-for="Ativo" id="serie-ativa" />
        <label for="serie-ativa">Série Ativa Principal</label>
    </div>
</div>

<div class="grade-formulario-3 grade-formulario-espacada">
    <div class="campo-grupo">
        <app-select id="Ambiente" asp-for="Ambiente" label="Ambiente SEFAZ">
            <option value="2" selected="@(Model.Ambiente == 2 ? "selected" : null)">Homologação</option>
            <option value="1" selected="@(Model.Ambiente == 1 ? "selected" : null)">Produção</option>
        </app-select>
    </div>
    <div class="campo-grupo">
        <app-select id="Modelo" asp-for="Modelo" label="Modelo">
            <option value="65" selected="@(Model.Modelo == 65 ? "selected" : null)">NFC-e (65)</option>
            <option value="55" selected="@(Model.Modelo == 55 ? "selected" : null)">NF-e (55)</option>
        </app-select>
    </div>
    <div class="campo-grupo">
        <app-input type="number" asp-for="Serie" min="1" max="999" label="Série"></app-input>
    </div>
</div>

<div class="grade-formulario-2 grade-formulario-espacada">
    <div class="campo-grupo">
        <app-input type="number" asp-for="ProximoNumeroNf" min="1" label="Próximo Nº da NF (Talonário)"></app-input>
        <span class="dica-campo">A próxima nota emitida usará este número. Altere com cuidado.</span>
    </div>
    <div class="campo-grupo">
        <app-select asp-for="TipoEmissaoPadrao" label="Tipo de Emissão">
            <option value="1" selected="@(Model.TipoEmissaoPadrao == 1 ? "selected" : null)">Normal (Online)</option>
            <option value="9" selected="@(Model.TipoEmissaoPadrao == 9 ? "selected" : null)">Contingência (Offline)</option>
        </app-select>
    </div>
</div>

<hr class="divisor" />

<div id="camposCsc" class="campos-csc @(Model.Modelo == 65 ? "" : "campos-csc--hidden")">
    <div class="rotulo-secao-formulario">
        CSC — Código de Segurança do Contribuinte (NFC-e)
    </div>
    <div class="grade-formulario-2">
        <div class="campo-grupo">
            <app-input asp-for="CscId" placeholder="Ex: 000001" label="CSC ID"></app-input>
        </div>
        <div class="campo-grupo">
            <app-input asp-for="CscToken" placeholder="Token gerado no portal SEFAZ do seu estado" label="CSC Token"></app-input>
        </div>
    </div>
    <hr class="divisor" />
</div>

<div class="rotulo-secao-formulario">
    Regras de Validação e Impressão
</div>
<div class="grade-formulario-2 grade-formulario-espacada">
    <div class="campo-grupo">
        <app-select asp-for="TipoImpressaoPadrao" label="Impressão do DANFe">
            <option value="1" selected="@(Model.TipoImpressaoPadrao == 1 ? "selected" : null)">Retrato</option>
            <option value="2" selected="@(Model.TipoImpressaoPadrao == 2 ? "selected" : null)">Paisagem</option>
        </app-select>
    </div>
    <div class="campo-grupo">
        <app-select asp-for="TratamentoDesconto" label="Tratamento de Desconto no XML">
            <option value="RATEIO" selected="@(Model.TratamentoDesconto == "RATEIO" ? "selected" : null)">Rateio por item</option>
            <option value="DESTAQUE" selected="@(Model.TratamentoDesconto == "DESTAQUE" ? "selected" : null)">Destaque no total</option>
        </app-select>
    </div>
</div>
