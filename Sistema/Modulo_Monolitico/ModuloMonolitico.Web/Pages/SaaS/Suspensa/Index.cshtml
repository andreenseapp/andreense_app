@page
@model ModuloMonolitico.Web.Pages.SaaS.Suspensa.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Conta Suspensa";
    Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/SaaS/css/suspensa-index.css" asp-append-version="true" />
}

<div class="suspensa-wrapper">
    <div class="suspensa-card">
        <div class="suspensa-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        </div>

        <div class="suspensa-badge">Acesso Suspenso</div>
        <h1 class="suspensa-title">Sua conta está suspensa</h1>
        <p class="suspensa-desc">
            O acesso à sua conta foi temporariamente suspenso devido a uma pendência financeira ou cancelamento de assinatura.
            Todos os seus dados estão preservados e seguros.
        </p>

        <div class="contact-box">
            <p class="contact-box-intro">Para regularizar sua situação, entre em contato com nosso suporte:</p>
            <div class="contact-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                suporte@andreense.com.br
            </div>
            <div class="contact-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                (17) 99999-9999
            </div>
        </div>

        <a href="@ModuloRotas.Autenticacao.Sair" class="btn-sair">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Sair da conta
        </a>
    </div>
</div>
