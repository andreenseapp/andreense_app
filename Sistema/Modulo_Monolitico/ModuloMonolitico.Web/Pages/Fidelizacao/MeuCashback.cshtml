@page
@model ModuloMonolitico.Web.Pages.Fidelizacao.MeuCashbackModel
@{
    ViewData[ViewDataKeys.Title] = "Meu Cashback";
    Layout = "~/Pages/Shared/Layouts/_AreaClienteLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Fidelizacao/css/meu-cashback.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div class="selo-pagina selo-pagina--cashback">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        Cashback
    </div>
    <h1 class="titulo-pagina">Meu Cashback</h1>
    <p class="subtitulo-pagina">Saldo acumulado em lojas parceiras para usar em compras futuras.</p>
</div>

@{
    var totalFormatado = Model.TotalDisponivel.ToString("C", new System.Globalization.CultureInfo("pt-BR"));
    var temHistorico = Model.HistoricoCreditos.Any();
    var temSaldo = Model.SaldosPorEmpresa.Any();
}

<div class="cashback-hero">
    <div class="cashback-hero-label">Seu saldo total disponível</div>
    <div class="cashback-hero-value"><span>@totalFormatado</span></div>
    <div class="cashback-hero-sub">em cashback acumulado em lojas parceiras</div>
</div>

@if (temSaldo)
{
    <p class="rotulo-secao">Saldo por Loja</p>
    <div class="empresa-list">
        @foreach (var saldo in Model.SaldosPorEmpresa)
        {
            var inicial = saldo.NomeEmpresa.Length > 0 ? saldo.NomeEmpresa[0].ToString().ToUpper() : "L";
            <div class="empresa-card">
                <div class="empresa-info">
                    <div class="empresa-avatar">@inicial</div>
                    <div>
                        <div class="empresa-nome">@saldo.NomeEmpresa</div>
                        <div class="empresa-atualizado">
                            Atualizado em @saldo.DataUltimaAtualizacao.ToLocalTime().ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
                <div class="empresa-saldo">
                    <div class="saldo-valor">@saldo.SaldoDisponivel.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                    <div class="saldo-label">disponível</div>
                </div>
            </div>
        }
    </div>
}
else if (!temHistorico)
{
    <div class="estado-vazio-cliente">
        <div class="estado-vazio-icone" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <h3 class="estado-vazio-titulo">Nenhum cashback ainda</h3>
        <p class="estado-vazio-texto">
            Escaneie o QR Code de uma loja parceira que oferece cashback para começar a acumular saldo.
        </p>
        <a href="@ModuloRotas.Fidelizacao.LerQRCode" class="cta-escanear">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            Escanear QR Code
        </a>
    </div>
}

@if (temHistorico)
{
    <p class="historico-title">Histórico de Créditos</p>

    @foreach (var credito in Model.HistoricoCreditos)
    {
        var cssSituacao = credito.Situacao.ToLower() switch {
            "disponivel" => "disponivel",
            "esgotado"   => "esgotado",
            "expirado"   => "expirado",
            _            => "disponivel"
        };
        var rotuloSituacao = credito.Situacao.ToLower() switch {
            "disponivel" => "Disponível",
            "esgotado"   => "Utilizado",
            "expirado"   => "Expirado",
            _            => credito.Situacao
        };
        var valorRestante = credito.ValorInicial - credito.ValorUtilizado;

        <div class="credito-item">
            <div class="credito-icon @cssSituacao" aria-hidden="true">
                @if (cssSituacao == "disponivel")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                }
                else if (cssSituacao == "esgotado")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                }
            </div>
            <div class="credito-body">
                <div class="credito-desc">
                    @(string.IsNullOrEmpty(credito.Descricao) ? "Cashback recebido" : credito.Descricao)
                    @if (!string.IsNullOrEmpty(credito.CodigoReferencia))
                    {
                        <span class="credito-ref"> · Ref: @credito.CodigoReferencia</span>
                    }
                </div>
                <div class="credito-data">
                    @credito.DataInclusao.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")
                    @if (credito.DataExpiracao.HasValue && credito.Situacao == "disponivel")
                    {
                        <span class="credito-expira"> · Vence em @credito.DataExpiracao.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    }
                </div>
            </div>
            <div class="credito-valores">
                <div class="credito-valor-principal @cssSituacao">
                    @credito.ValorInicial.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                </div>
                <div>
                    <span class="credito-selo-situacao badge-@cssSituacao">@rotuloSituacao</span>
                </div>
                @if (credito.ValorUtilizado > 0 && credito.Situacao != "esgotado")
                {
                    <div class="credito-restante">
                        Restam @valorRestante.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                    </div>
                }
            </div>
        </div>
    }

    <partial name="Toolbars/_Paginacao" />

    <div class="cta-escanear-wrap">
        <a href="@ModuloRotas.Fidelizacao.LerQRCode" class="cta-escanear">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            Escanear Novo QR Code
        </a>
    </div>
}
