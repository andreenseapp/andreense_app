@page
@model ModuloMonolitico.Web.Pages.Fidelizacao.Cashback.NovoModel
@{
    ViewData[ViewDataKeys.Title] = "Nova Regra de Cashback";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Fidelizacao/css/cashback-novo.css" asp-append-version="true" />
}

<partial name="Toolbars/_ToolbarForm" model='new ModuloMonolitico.Web.Pages.Shared.Toolbars.ToolbarViewModel() {
    UrlVoltar = ModuloRotas.Fidelizacao.Cashback,
    TextoVoltar = "Campanhas",
    Titulo = "Nova Regra de Cashback",
    Subtitulo = "Defina percentual, validade e vigência da campanha."
}' />

<main class="conteudo-principal cashback-novo-container">
    <form method="post" id="formRegraCashback" class="cartao-formulario">
        <h2 class="titulo-secao-formulario">Informações Básicas</h2>

        <div class="grade-formulario">
            <app-input asp-for="Regra.Titulo"
                       label="Título da Campanha *"
                       type="text"
                       placeholder="Ex: Cashback de Verão, Fidelidade Prime..."
                       required="required"
                       class="campo-formulario-full mb-0" />

            <app-textarea asp-for="Regra.Descricao"
                          label="Descrição (Opcional)"
                          rows="3"
                          placeholder="Explique como funciona para seus clientes..."
                          class="campo-formulario-full campo-formulario-spaced mb-0" />

            <app-input asp-for="Regra.Percentual"
                       label="Percentual de Cashback (%) *"
                       type="number"
                       step="0.1"
                       required="required"
                       class="campo-formulario-spaced mb-0" />

            <app-input asp-for="Regra.DiasValidade"
                       label="Validade dos Créditos (Dias)"
                       type="number"
                       placeholder="Ex: 30, 60, 90..."
                       class="campo-formulario-spaced mb-0" />
        </div>

        <h2 class="titulo-secao-formulario">Configurações Avançadas</h2>

        <div class="grade-formulario">
            <app-input asp-for="Regra.DataInicioVigencia"
                       label="Data Início (Vigência)"
                       type="date"
                       class="mb-0" />

            <app-input asp-for="Regra.DataFimVigencia"
                       label="Data Fim (Vigência)"
                       type="date"
                       class="campo-formulario-spaced mb-0" />

            <app-checkbox asp-for="Regra.TemReferencia" class="campo-formulario-full checkbox-card mb-0">
                <span class="checkbox-titulo-cartao">Exigir Código de Referência</span>
                <span class="checkbox-card-desc">Obrigatório informar número da nota ou venda ao creditar.</span>
            </app-checkbox>
        </div>

        <div class="acoes-formulario">
            <a href="@ModuloRotas.Fidelizacao.Cashback" class="botao-cancelar">Descartar</a>
            <app-save-button type="submit">Salvar Regra</app-save-button>
        </div>
    </form>
</main>

@section Scripts {
    <script src="~/Contextos/Shared/js/captura-formulario.js" asp-append-version="true"></script>
}
