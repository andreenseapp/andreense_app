@page
@model ModuloMonolitico.Web.Pages.AreaServicos.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Área de Serviços";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

<div class="cabecalho-pagina">
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
            Serviços
        </div>
        <h1 class="titulo-pagina">Área de Serviços</h1>
        <p class="subtitulo-pagina">Agendamentos, prestadores e fidelização do seu negócio de serviços.</p>
    </div>
</div>

<div class="modulos-grid">
    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Agendamentos.Painel,
        nome = "Agendamentos",
        descricao = "Calendário visual, painel do dia e gestão de horários.",
        textoLink = "Abrir Painel",
        corHexadecimal = "#6366f1", corRgb = "99, 102, 241",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Agendamentos.Configuracoes,
        nome = "Configurações",
        descricao = "Horários, serviços e vínculos de profissionais.",
        textoLink = "Configurar",
        corHexadecimal = "#8b5cf6", corRgb = "139, 92, 246",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"></path></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Fidelizacao.Index,
        nome = "Fidelização",
        descricao = "Cartões fidelidade, cashback e benefícios para clientes.",
        textoLink = "Ver Fidelização",
        corHexadecimal = "#f59e0b", corRgb = "245, 158, 11",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"5\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"2\" y1=\"10\" x2=\"22\" y2=\"10\"></line></svg>"
    })
</div>
