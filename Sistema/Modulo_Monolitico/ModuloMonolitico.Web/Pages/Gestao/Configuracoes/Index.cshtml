@page
@model ModuloMonolitico.Web.Pages.Gestao.Configuracoes.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Configurações";
    Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
    var urlEmpresa = Model.EmpresaId.HasValue
        ? $"{ModuloRotas.Empresas.Empresas_Editar}?id={Model.EmpresaId}"
        : ModuloRotas.Empresas.Index;
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Gestao/css/configuracoes-index.css" asp-append-version="true" />
}

<div class="cabecalho-pagina configuracoes-header">
    <div>
        <div class="selo-pagina">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.18V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            Base
        </div>
        <h1 class="titulo-pagina">Configurações</h1>
        <p class="subtitulo-pagina">Gerencie sua conta, dados da empresa e parâmetros do sistema.</p>
    </div>
</div>

<section class="secao-configuracoes">
    <h2 class="titulo-secao-configuracoes">Pessoal e Conta</h2>
    <div class="grade-configuracoes">
        <a href="@ModuloRotas.Perfil.MeuPerfil" class="cartao-configuracoes">
            <div class="icone-configuracoes icone-configuracoes-primario">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Meu Perfil</span>
                <p class="desc-configuracoes">Foto de perfil, nome de exibição, alteração de e-mail e senha de acesso.</p>
            </div>
        </a>

        <a href="@ModuloRotas.Autenticacao.Sair" class="cartao-configuracoes">
            <div class="icone-configuracoes icone-configuracoes-suave">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Sair do Sistema</span>
                <p class="desc-configuracoes">Encerrar sua sessão atual de forma segura neste dispositivo.</p>
            </div>
        </a>
    </div>
</section>

<section class="secao-configuracoes">
    <h2 class="titulo-secao-configuracoes">Empresa e Negócio</h2>
    <div class="grade-configuracoes">
        <a href="@urlEmpresa" class="cartao-configuracoes">
            <div class="icone-configuracoes icone-configuracoes-primario">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Dados da Empresa</span>
                <p class="desc-configuracoes">CNPJ, Inscrição Estadual, endereço fiscal e atividades econômicas.</p>
            </div>
        </a>

        <a href="@ModuloRotas.Gestao.Vendedores" class="cartao-configuracoes">
            <div class="icone-configuracoes icone-configuracoes-primario">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Equipe de Vendas</span>
                <p class="desc-configuracoes">Gerencie seus vendedores, tipos de comissão e carteiras de clientes.</p>
            </div>
        </a>

        <a href="@ModuloRotas.Fiscal.Certificados" class="cartao-configuracoes">
            <div class="icone-configuracoes icone-configuracoes-sucesso">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Configurações Fiscais</span>
                <p class="desc-configuracoes">Certificado digital A1, talonário, série e ambiente de emissão de NF-e / NFC-e.</p>
            </div>
        </a>
    </div>
</section>

<section class="secao-configuracoes">
    <h2 class="titulo-secao-configuracoes">Avançado e Integrações</h2>
    <div class="grade-configuracoes">
        <div class="cartao-configuracoes cartao-configuracoes-desabilitado" aria-disabled="true">
            <div class="icone-configuracoes icone-configuracoes-aviso">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Cloudflare R2</span>
                <p class="desc-configuracoes">Configuração do bucket de imagens, chaves de API e URLs públicas.</p>
                <span class="em-breve-configuracoes">Em breve</span>
            </div>
        </div>

        <div class="cartao-configuracoes cartao-configuracoes-desabilitado" aria-disabled="true">
            <div class="icone-configuracoes icone-configuracoes-sucesso">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 1 1-7.6-10.8 8.43 8.43 0 0 1 3.1 0"></path><path d="M16 5L22 11L16 17"></path><path d="M12 11H22"></path></svg>
            </div>
            <div class="info-configuracoes">
                <span class="rotulo-configuracoes">Webhooks</span>
                <p class="desc-configuracoes">Notificações automáticas para sistemas externos e integração de API.</p>
                <span class="em-breve-configuracoes">Em breve</span>
            </div>
        </div>
    </div>
</section>
