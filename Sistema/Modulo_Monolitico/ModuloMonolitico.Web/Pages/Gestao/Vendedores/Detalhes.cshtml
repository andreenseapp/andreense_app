@page
@model ModuloMonolitico.Web.Pages.Gestao.Vendedores.DetalhesModel
@{
    ViewData[ViewDataKeys.Title] = Model.Vendedor?.NomeFantasia ?? "Detalhes do Vendedor";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
    var urlEditar = $"{ModuloRotas.Gestao.Vendedores_Editar}?id={Model.Vendedor?.Id}";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Gestao/css/vendedores-detalhes.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div>
        <div class="selo-pagina">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
            CRM
        </div>
        <h1 class="titulo-pagina">@Model.Vendedor?.NomeFantasia</h1>
        <p class="subtitulo-pagina">Perfil do vendedor cadastrado na carteira comercial.</p>
    </div>
    <div class="cabecalho-pagina-acoes">
        <a href="@ModuloRotas.Gestao.Vendedores" class="botao botao-fantasma botao-voltar">← Vendedores</a>
        <a href="@urlEditar" class="botao botao-primario botao-cabecalho-editar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"></path></svg>
            Editar Cadastro
        </a>
    </div>
</div>

<main class="main-content vendedores-detalhes-container">
    <div class="detalhes-grid">
        <div class="detalhes-col-principal">
            <section class="cartao-info">
                <h2 class="titulo-cartao-info">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Informações do Vendedor
                </h2>
                <div class="grade-info">
                    <div class="campo-info">
                        <span class="rotulo-info">Nome Fantasia / Apelido</span>
                        <span class="valor-info">@Model.Vendedor?.NomeFantasia</span>
                    </div>
                    <div class="campo-info">
                        <span class="rotulo-info">Tipo / Perfil</span>
                        <span class="valor-info">@(Model.Vendedor?.TipoVendedor?.Nome ?? "Vendedor")</span>
                    </div>
                    <div class="campo-info">
                        <span class="rotulo-info">Usuário Vinculado</span>
                        <span class="valor-info">@(string.IsNullOrEmpty(Model.NomeUsuarioVinculado) ? "Sem usuário vinculado" : Model.NomeUsuarioVinculado)</span>
                    </div>
                </div>
            </section>

            <section class="cartao-info">
                <h2 class="titulo-cartao-info">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                    Observações Internas
                </h2>
                @if (string.IsNullOrEmpty(Model.Vendedor?.Observacao))
                {
                    <p class="observacao-vazia">Nenhuma observação interna registrada para este vendedor.</p>
                }
                else
                {
                    <div class="observacao-texto">@Model.Vendedor.Observacao</div>
                }
            </section>
        </div>

        <aside class="detalhes-col-lateral">
            <section class="cartao-info">
                <h2 class="titulo-cartao-info">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.18V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    Situação e Auditoria
                </h2>
                <div class="lista-meta">
                    <div class="item-meta">
                        <span class="rotulo-info">Situação de Atividade</span>
                        <span class="badge-situacao @(Model.Vendedor?.Ativo == true ? "situacao-ativo" : "situacao-inativo")">
                            @(Model.Vendedor?.Ativo == true ? "Ativo" : "Inativo")
                        </span>
                    </div>
                    <div class="item-meta">
                        <span class="rotulo-info">Data de Inclusão</span>
                        <span class="valor-info">@(Model.Vendedor?.DataInclusao.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                    <div class="item-meta">
                        <span class="rotulo-info">Última Atualização</span>
                        <span class="valor-info">@(Model.Vendedor?.DataUltimaAtualizacao.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                    </div>
                </div>
            </section>
        </aside>
    </div>
</main>
