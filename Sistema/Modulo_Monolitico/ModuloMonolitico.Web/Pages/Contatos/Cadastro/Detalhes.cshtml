@page
@model ModuloMonolitico.Web.Pages.Contatos.Cadastro.DetalhesModel
@{
    var papelLista = Model.Papel switch
    {
        "cliente" => "Clientes",
        "fornecedor" => "Fornecedores",
        "funcionario" => "Funcionários",
        "transportador" => "Transportadoras",
        "lead" => "Leads",
        "prospect" => "Prospects",
        _ => "Contatos"
    };

    var tituloContato = Model.Contato?.TipoPessoa == "fisica"
        ? Model.Contato?.NomeCompleto
        : Model.Contato?.RazaoSocial;

    ViewData[ViewDataKeys.Title] = $"Visualizar Contato — {Model.Contato?.NomeCompleto ?? Model.Contato?.NomeFantasia ?? "Detalhes"}";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";

    var urlVoltar = string.IsNullOrEmpty(Model.Papel)
        ? ModuloRotas.Contatos.Cadastro
        : $"{ModuloRotas.Contatos.Cadastro}?Papel={Model.Papel}";
    var urlEditar = string.IsNullOrEmpty(Model.Papel)
        ? $"{ModuloRotas.Contatos.Cadastro_Editar}?id={Model.Contato?.Id}"
        : $"{ModuloRotas.Contatos.Cadastro_Editar}?id={Model.Contato?.Id}&Papel={Model.Papel}";
    var textoVoltar = string.IsNullOrEmpty(Model.Papel) ? "Contatos" : $"Meus {papelLista}";
}

@section Styles {
    <link rel="stylesheet" href="~/Contextos/Contatos/css/cadastro-detalhes.css" asp-append-version="true" />
}

<div class="cabecalho-pagina">
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            CRM
        </div>
        <h1 class="titulo-pagina">@tituloContato</h1>
        @if (Model.Contato?.TipoPessoa == "juridica" && !string.IsNullOrEmpty(Model.Contato?.NomeFantasia))
        {
            <p class="subtitulo-pagina">@Model.Contato.NomeFantasia</p>
        }
        else
        {
            <p class="subtitulo-pagina">Visualização completa do cadastro de contato.</p>
        }
    </div>
    <div class="cabecalho-pagina-acoes">
        <a href="@urlVoltar" class="botao botao-fantasma botao-voltar">← @textoVoltar</a>
        <a href="@urlEditar" class="botao botao-primario btn-header-editar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"></path></svg>
            Editar Cadastro
        </a>
    </div>
</div>

<main class="main-content cadastro-detalhes-container">
    <div class="detalhes-grid">
        <div class="detalhes-col-principal">
            <section class="info-card">
                <h2 class="info-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Informações Gerais
                </h2>
                <div class="info-grid">
                    @if (Model.Contato?.TipoPessoa == "fisica")
                    {
                        <div class="info-field">
                            <span class="info-label">Nome Completo</span>
                            <span class="info-value">@Model.Contato.NomeCompleto</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">CPF</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato.Cpf) ? "—" : Model.Contato.Cpf)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">RG</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato.Rg) ? "—" : Model.Contato.Rg)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Data de Nascimento</span>
                            <span class="info-value">@(Model.Contato.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Gênero</span>
                            <span class="info-value info-value--capitalize">@(string.IsNullOrEmpty(Model.Contato.Genero) ? "—" : Model.Contato.Genero)</span>
                        </div>
                    }
                    else
                    {
                        <div class="info-field">
                            <span class="info-label">Razão Social</span>
                            <span class="info-value">@Model.Contato?.RazaoSocial</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Nome Fantasia</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.NomeFantasia) ? "—" : Model.Contato.NomeFantasia)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">CNPJ</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.Cnpj) ? "—" : Model.Contato.Cnpj)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Inscrição Estadual</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.InscricaoEstadual) ? "—" : Model.Contato.InscricaoEstadual)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Inscrição Municipal</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.InscricaoMunicipal) ? "—" : Model.Contato.InscricaoMunicipal)</span>
                        </div>
                        <div class="info-field">
                            <span class="info-label">Regime Tributário (CRT)</span>
                            <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.Crt) ? "—" : Model.Contato.Crt)</span>
                        </div>
                    }

                    <div class="info-field">
                        <span class="info-label">E-mail</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.Email) ? "—" : Model.Contato.Email)</span>
                    </div>
                    <div class="info-field">
                        <span class="info-label">Telefone</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.Contato?.Telefone) ? "—" : Model.Contato.Telefone)</span>
                    </div>
                </div>
            </section>

            <section class="info-card">
                <h2 class="info-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    Endereços Cadastrados
                </h2>

                @if (Model.Contato?.Enderecos == null || !Model.Contato.Enderecos.Any())
                {
                    <p class="endereco-vazio">Nenhum endereço cadastrado para este contato.</p>
                }
                else
                {
                    <div class="endereco-lista">
                        @foreach (var end in Model.Contato.Enderecos)
                        {
                            <div class="endereco-detalhe">
                                <div class="endereco-detalhe-corpo">
                                    <div class="endereco-detalhe-linha-principal">
                                        @end.Logradouro, @end.Numero @(!string.IsNullOrEmpty(end.Complemento) ? $" - {end.Complemento}" : "")
                                    </div>
                                    <div class="endereco-detalhe-linha-secundaria">
                                        @end.Bairro @(!string.IsNullOrEmpty(end.Cidade) ? $" - {end.Cidade}" : "") / @end.Uf
                                    </div>
                                    <div class="endereco-detalhe-cep">
                                        CEP: @end.Cep
                                    </div>
                                </div>

                                <div class="endereco-tags">
                                    @if (Model.Contato.EnderecoEntregaId == end.Id)
                                    {
                                        <span class="endereco-tag endereco-tag--entrega">Entrega</span>
                                    }
                                    @if (Model.Contato.EnderecoFaturamentoId == end.Id)
                                    {
                                        <span class="endereco-tag endereco-tag--faturamento">Faturamento</span>
                                    }
                                    @if (Model.Contato.EnderecoFiscalId == end.Id)
                                    {
                                        <span class="endereco-tag endereco-tag--fiscal">Fiscal</span>
                                    }
                                    @if (Model.Contato.EnderecoCobrancaId == end.Id)
                                    {
                                        <span class="endereco-tag endereco-tag--cobranca">Cobrança</span>
                                    }
                                    @if (Model.Contato.EnderecoRetiradaId == end.Id)
                                    {
                                        <span class="endereco-tag endereco-tag--retirada">Retirada</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="detalhes-col-lateral">
            <section class="info-card">
                <h2 class="info-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                    Papéis de Perfil
                </h2>

                <div class="papel-lista">
                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "cliente")
                    {
                        <div class="papel-detalhe @(Model.PapelCliente != null ? "papel-detalhe--ativo papel-detalhe--cliente" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Cliente</span>
                                <span class="distintivo-situacao @(Model.PapelCliente != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelCliente != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelCliente != null)
                            {
                                <div class="papel-detalhe-meta">
                                    <span><strong>Limite de Crédito:</strong> @Model.PapelCliente.LimiteCredito.ToString("C")</span>
                                    <span><strong>Desconto Padrão:</strong> @Model.PapelCliente.DescontoPadrao.ToString("F2")%</span>
                                    @if (!string.IsNullOrEmpty(Model.PapelCliente.Observacao))
                                    {
                                        <span class="papel-detalhe-observacao">"@Model.PapelCliente.Observacao"</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "fornecedor")
                    {
                        <div class="papel-detalhe @(Model.PapelFornecedor != null ? "papel-detalhe--ativo papel-detalhe--fornecedor" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Fornecedor</span>
                                <span class="distintivo-situacao @(Model.PapelFornecedor != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelFornecedor != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelFornecedor != null && !string.IsNullOrEmpty(Model.PapelFornecedor.Observacao))
                            {
                                <div class="papel-detalhe-observacao">"@Model.PapelFornecedor.Observacao"</div>
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "transportador")
                    {
                        <div class="papel-detalhe @(Model.PapelTransportador != null ? "papel-detalhe--ativo papel-detalhe--transportador" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Transportador</span>
                                <span class="distintivo-situacao @(Model.PapelTransportador != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelTransportador != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelTransportador != null && !string.IsNullOrEmpty(Model.PapelTransportador.Observacao))
                            {
                                <div class="papel-detalhe-observacao">"@Model.PapelTransportador.Observacao"</div>
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "lead")
                    {
                        <div class="papel-detalhe @(Model.PapelLead != null ? "papel-detalhe--ativo papel-detalhe--lead" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Lead</span>
                                <span class="distintivo-situacao @(Model.PapelLead != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelLead != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelLead != null && !string.IsNullOrEmpty(Model.PapelLead.Observacao))
                            {
                                <div class="papel-detalhe-observacao">"@Model.PapelLead.Observacao"</div>
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "prospect")
                    {
                        <div class="papel-detalhe @(Model.PapelProspect != null ? "papel-detalhe--ativo papel-detalhe--prospect" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Prospect</span>
                                <span class="distintivo-situacao @(Model.PapelProspect != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelProspect != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelProspect != null && !string.IsNullOrEmpty(Model.PapelProspect.Observacao))
                            {
                                <div class="papel-detalhe-observacao">"@Model.PapelProspect.Observacao"</div>
                            }
                        </div>
                    }

                    @if (string.IsNullOrEmpty(Model.Papel) || Model.Papel == "funcionario")
                    {
                        <div class="papel-detalhe @(Model.PapelFuncionario != null ? "papel-detalhe--ativo papel-detalhe--funcionario" : "")">
                            <div class="papel-detalhe-header">
                                <span class="papel-detalhe-nome">Funcionário</span>
                                <span class="distintivo-situacao @(Model.PapelFuncionario != null ? "situacao-ativo" : "situacao-inativo")">
                                    @(Model.PapelFuncionario != null ? "Ativo" : "Inativo")
                                </span>
                            </div>
                            @if (Model.PapelFuncionario != null && !string.IsNullOrEmpty(Model.PapelFuncionario.Observacao))
                            {
                                <div class="papel-detalhe-observacao">"@Model.PapelFuncionario.Observacao"</div>
                            }
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</main>
