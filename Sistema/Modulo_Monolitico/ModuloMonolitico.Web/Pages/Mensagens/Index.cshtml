@page
@model ModuloMonolitico.Web.Pages.Mensagens.IndexModel
@{
  ViewData[ViewDataKeys.Title] = "Mensagens";
  ViewData[ViewDataKeys.Description] = "Caixa de entrada e histórico de conversas.";
  Layout = "~/Pages/Shared/Layouts/_AppLayout.cshtml";
}

@section Styles {
  <link rel="stylesheet" href="~/Contextos/Mensagens/css/index.css" asp-append-version="true" />
}

<div class="inbox-layout @(Model.TopicoAtivoId.HasValue ? "has-topico" : "")">

  <aside class="inbox-sidebar" role="navigation" aria-label="Conversas">
    <div class="sidebar-header">
      <h2>Mensagens</h2>
      <span class="sidebar-unread-count">
        @Model.Topicos.Sum(o => o.NaoLidas) não lida(s)
      </span>
    </div>

    <div class="sidebar-search">
      <app-input type="search" id="busca-topicos" class="campo-controle mb-0" placeholder="Buscar conversa..." aria-label="Buscar conversa" autocomplete="off" />
    </div>

    <div class="topicos-list" id="topicos-list" role="list">
      @if (!Model.Topicos.Any())
      {
        <div class="sidebar-empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <p>Nenhuma conversa ainda.</p>
        </div>
      }
      else
      {
        @foreach (var topico in Model.Topicos)
        {
          var isActive = topico.Id == Model.TopicoAtivoId;
          var inicial = (topico.Titulo ?? "?")[0].ToString().ToUpper();
          <a href="?topicoId=@topico.Id"
            class="topico-item @(isActive ? "active" : "")"
            role="listitem"
            aria-current="@(isActive ? "true" : "false")">
            <div class="topico-avatar">@inicial</div>
            <div class="topico-info">
              <div class="topico-nome">@(topico.Titulo ?? "Conversa direta")</div>
              <div class="topico-preview">@(topico.UltimaMensagemPreview ?? "Sem mensagens ainda")</div>
            </div>
            <div class="topico-meta">
              <span class="topico-data">@topico.DataUltimaInteracao.ToLocalTime().ToString("HH:mm")</span>
              @if (topico.NaoLidas > 0)
              {
                <span class="topico-badge">@(topico.NaoLidas > 99 ? "99+" : topico.NaoLidas.ToString())</span>
              }
            </div>
          </a>
        }
      }
    </div>
  </aside>

  <main class="inbox-panel" role="main">

    @if (Model.TopicoAtivo == null)
    {
      <div class="panel-empty">
        <div class="panel-empty-icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <h3>Selecione uma conversa</h3>
        <p>Escolha um oópico na lista à esquerda para ver o histórico de mensagens.</p>
      </div>
    }
    else
    {
      <div class="panel-header">
        <div class="panel-header-avatar">
          @((Model.TopicoAtivo.Titulo ?? "?")[0].ToString().ToUpper())
        </div>
        <div class="panel-header-info">
          <div class="panel-header-nome">@(Model.TopicoAtivo.Titulo ?? "Conversa direta")</div>
          <div class="panel-header-status">
            @(Model.TopicoAtivo.Tipo == "grupo" ? "Grupo" : "Mensagem direta")
          </div>
        </div>
      </div>

      <div class="messages-area" id="messages-area" aria-live="polite" aria-label="Histórico de mensagens">
        @if (!Model.Mensagens.Any())
        {
          <div class="messages-empty-hint">
            Nenhuma mensagem ainda. Seja o primeiro a enviar!
          </div>
        }
        else
        {
          @foreach (var msg in Model.Mensagens)
          {
            var isMinh = msg.RemetenteId == Model.UsuarioId;
            <div class="msg-row @(isMinh ? "mine" : "")">
              @if (!isMinh)
              {
                <div class="msg-avatar-sm" aria-hidden="true">U</div>
              }
              <div class="msg-bubble @(isMinh ? "mine" : "other")">
                @Html.Raw(Model.RenderizarCorpoTextoSeguro(msg.CorpoTexto))
                <span class="msg-time">@msg.DataEnvio.ToLocalTime().ToString("HH:mm")</span>
              </div>
            </div>
          }
        }
      </div>

      <div class="compose-area">
        <form method="post" asp-page-handler="Enviar" id="form-compose" class="compose-form">
          <app-input type="hidden" asp-for="TopicoIdInput" value="@Model.TopicoAtivoId" />
          <app-textarea
            id="compose-input"
            name="CorpoTexto"
            class="campo-controle compose-input mb-0"
            placeholder="Escreva uma mensagem..."
            rows="1" />
          <app-button type="submit" variant="ghost" class="compose-send" aria-label="Enviar mensagem">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </app-button>
        </form>
      </div>
    }
  </main>
</div>

@section Scripts {
<script src="~/Contextos/Mensagens/js/index.js" asp-append-version="true"></script>
}
