@page
@model ModuloMonolitico.Web.Pages.Varejo.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Varejo — Frente de Caixa";
    Layout = "~/Pages/Shared/Layouts/_ModuleLayout.cshtml";
}

<div class="cabecalho-pagina">
    <div>
        <div class="page-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line></svg>
            Varejo
        </div>
        <h1 class="titulo-pagina">Frente de Caixa</h1>
        <p class="subtitulo-pagina">Vendas rápidas, PDV e gestão do caixa da sua loja.</p>
    </div>
</div>

<div class="construcao-banner mb-4">
    <div class="construcao-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
    </div>
    <div>
        <div class="construcao-titulo">Módulo em Desenvolvimento</div>
        <div class="construcao-desc">
            O módulo de Varejo está sendo construído. As funcionalidades de PDV, controle de caixa
            e vendas rápidas estarão disponíveis em breve. Os módulos disponíveis abaixo mostram
            o que está planejado para esta área.
        </div>
    </div>
</div>

<div class="modulos-grid">
    @await Component.InvokeAsync("ModuloCard", new {
        url = "#",
        nome = "PDV — Ponto de Venda",
        descricao = "Interface de venda rápida com leitura de código de barras, seleção de produtos e finalização de venda em segundos.",
        textoLink = "Em breve",
        corHexadecimal = "#94a3b8", corRgb = "148, 163, 184",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"></line><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"></line></svg>",
        emBreve = true
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = "#",
        nome = "Controle de Caixa",
        descricao = "Abertura, sangria, suprimento e fechamento de caixa com relatório consolidado por turno.",
        textoLink = "Em breve",
        corHexadecimal = "#94a3b8", corRgb = "148, 163, 184",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"></line><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg>",
        emBreve = true
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = "#",
        nome = "Cupom Fiscal (" + TerminologiaErp.AbreviacaoNotaFiscalConsumidorEletronica + ")",
        descricao = "Emissão de " + TerminologiaErp.NomeNotaFiscalConsumidor + " eletrônica integrada ao PDV, com transmissão em tempo real à SEFAZ.",
        textoLink = "Em breve",
        corHexadecimal = "#94a3b8", corRgb = "148, 163, 184",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline></svg>",
        emBreve = true
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Fidelizacao.Cashback,
        nome = "Cashback",
        descricao = "Retorne parte do valor da compra como crédito para seus clientes usarem no futuro.",
        textoLink = "Gerenciar Cashback",
        corHexadecimal = "#10b981", corRgb = "16, 185, 129",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Fidelizacao.Fidelidade,
        nome = "Cartão Fidelidade",
        descricao = "Sistema de carimbos/selos. A cada compra o cliente ganha um selo para trocar por prêmios.",
        textoLink = "Gerenciar Fidelidade",
        corHexadecimal = "#f59e0b", corRgb = "245, 158, 11",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 7h-9l-1-1H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = "#",
        nome = "Relatório de Vendas",
        descricao = "Painel de resultados diários, semanais e mensais. Ranking de produtos mais vendidos e desempenho por período.",
        textoLink = "Em breve",
        corHexadecimal = "#94a3b8", corRgb = "148, 163, 184",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"></polyline></svg>",
        emBreve = true
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.Gestao.Vendedores,
        nome = "Equipe de Vendas",
        descricao = "Cadastre os vendedores para o PDV e defina os comissionados.",
        textoLink = "Gerenciar Vendedores",
        corHexadecimal = "#8b5cf6", corRgb = "139, 92, 246",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#8b5cf6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg>"
    })

    @await Component.InvokeAsync("ModuloCard", new {
        url = ModuloRotas.ERP.Index,
        nome = "Ir para o ERP",
        descricao = "Acesse a gestão completa: pedidos, estoque, financeiro, contatos e emissão de " + TerminologiaErp.AbreviacaoNotaFiscalEletronica + ".",
        textoLink = "Acessar ERP",
        corHexadecimal = "#3b82f6", corRgb = "59, 130, 246",
        svgIcone = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3b82f6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line><line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line></svg>"
    })
</div>
