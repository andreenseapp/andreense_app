@model ModuloMonolitico.Dominio.Imobiliaria.DTOs.AnuncioResumoDto
@using ModuloMonolitico.Dominio.Configuracoes
@{
    var badgeClass = Model.TipoNegocio == "venda" ? "badge--venda" : "badge--aluguel";
    var badgeTexto = Model.TipoNegocio == "venda" ? "Venda" : "Aluguel";
    var valorLabel = Model.TipoNegocio == "venda" ? "Valor" : "Aluguel/mês";
    
    var favoritosIds = ViewData[ViewDataKeys.FavoritosIds] as System.Collections.Generic.List<Guid> ?? new System.Collections.Generic.List<Guid>();
    var visualizadosIds = ViewData[ViewDataKeys.VisualizadosIds] as System.Collections.Generic.List<Guid> ?? new System.Collections.Generic.List<Guid>();
    var isFavorito = favoritosIds.Contains(Model.ImovelId);
    var isVisualizado = visualizadosIds.Contains(Model.AnuncioId);
    var classeFavorito = isFavorito ? "ativo" : "";
    var classeCard = isVisualizado ? "anuncio-card--visualizado" : "";
    var usuarioEhMaster = ViewData[ViewDataKeys.UsuarioEhMaster] as bool? == true;
}

<a href="@ModuloRotas.Imoveis.Detalhes?id=@Model.AnuncioId" class="anuncio-card @classeCard" id="anuncio-@Model.AnuncioId" data-anuncio-id="@Model.AnuncioId">
    <div class="anuncio-card-foto">
        @if (!string.IsNullOrEmpty(Model.FotoCapa))
        {
            <img src="@Model.FotoCapa" alt="@Model.Titulo" loading="lazy" />
        }
        else
        {
            <div class="anuncio-foto-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
        }
        <span class="anuncio-badge @badgeClass">@badgeTexto</span>
        @if (Model.EhDestaque)
        {
            <span class="anuncio-badge badge--destaque" data-selo-destaque>@MensagensSistema.Imobiliaria.SeloDestaque</span>
        }
        @if (isVisualizado)
        {
            <span class="anuncio-badge badge--visualizado">@MensagensSistema.Imobiliaria.SeloVisualizado</span>
        }
        <span class="anuncio-tipo-imovel">@Model.TipoImovel</span>

        @if (usuarioEhMaster)
        {
            <app-button type="button"
                    variant="ghost"
                    class="btn-destaque-admin @(Model.EhDestaque ? "ativo" : "")"
                    aria-label="@(Model.EhDestaque ? MensagensSistema.Imobiliaria.RemoverDestaqueAnuncio : MensagensSistema.Imobiliaria.DestacarAnuncio)"
                    title="@(Model.EhDestaque ? MensagensSistema.Imobiliaria.RemoverDestaqueAnuncio : MensagensSistema.Imobiliaria.DestacarAnuncio)"
                    data-anuncio-id="@Model.AnuncioId"
                    data-destaque-btn="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="@(Model.EhDestaque ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </app-button>
        }
        
        <app-button type="button" variant="ghost" class="btn-favoritar @classeFavorito" aria-label="Favoritar" data-imovel-id="@Model.ImovelId" data-favoritar-btn="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="icone-coracao">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
        </app-button>
    </div>

    <div class="anuncio-card-body">
        <h3 class="anuncio-titulo">@Model.Titulo</h3>
        <p class="anuncio-bairro">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            @Model.Bairro — Santo André
        </p>

        <div class="anuncio-specs">
            @if (Model.Quartos > 0)
            {
                <span class="spec-item" title="Quartos">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 22V8l9-6 9 6v14M3 22h18M12 22V12"></path></svg>
                    @Model.Quartos quarto@(Model.Quartos > 1 ? "s" : "")
                </span>
            }
            @if (Model.Banheiros > 0)
            {
                <span class="spec-item" title="Banheiros">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M5 12a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6m-6 8v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2m2-4H5"></path></svg>
                    @Model.Banheiros banheiro@(Model.Banheiros > 1 ? "s" : "")
                </span>
            }
            @if (Model.VagasGaragem > 0)
            {
                <span class="spec-item" title="Vagas">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                    @Model.VagasGaragem vaga@(Model.VagasGaragem > 1 ? "s" : "")
                </span>
            }
            @if (Model.AreaTotal.HasValue)
            {
                <span class="spec-item" title="Área">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 3H3v18h18V3z"></path></svg>
                    @Model.AreaTotal m²
                </span>
            }
        </div>

        <div class="anuncio-valores">
            <div class="valor-principal">
                <span class="valor-label">@valorLabel</span>
                <span class="valor-numero">R$ @Model.ValorPrincipal.ToString("N0")</span>
            </div>
            @if (Model.TipoNegocio == "aluguel" && (Model.ValorCondominio > 0 || Model.ValorIptu > 0))
            {
                <div class="valor-pacote">
                    <span class="valor-pacote-label">Pacote total</span>
                    <span class="valor-pacote-numero">R$ @Model.PacoteTotal.ToString("N0")/mês</span>
                </div>
            }
        </div>

        <div class="anuncio-card-footer">
            <object>
                <a href="@ModuloRotas.Imoveis.Anunciante?id=@Model.ContaId" class="anunciante-info" title="Ver todos os imóveis deste anunciante">
                    @if (!string.IsNullOrEmpty(Model.LogoAnunciante))
                    {
                        <img src="@Model.LogoAnunciante" alt="@Model.NomeAnunciante" class="anunciante-avatar" loading="lazy" />
                    }
                    else
                    {
                        <div class="anunciante-avatar-placeholder">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                    }
                    <span class="anunciante-nome">@Model.NomeAnunciante</span>
                </a>
            </object>
        </div>
    </div>
</a>
